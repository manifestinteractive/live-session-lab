# Phase 1 runs without credentials. These placeholders prepare for Phase 2.
# Copy to .env.local and enter real values locally when integration starts.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-your-api-key
LIVEKIT_API_SECRET=replace-with-your-api-secret
INVITATION_SIGNING_SECRET=replace-with-a-random-server-only-secret
APP_ORIGIN=http://localhost:3000
ADMISSION_ENABLED=false
