# Copy to ignored .env.local. Enter real values locally, never in chat.
# The join page and local preview work without service credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-your-api-key
LIVEKIT_API_SECRET=replace-with-your-api-secret
# Reusable codes are server-only. Use different random codes, 20-128 characters.
# Allowed characters: letters, digits, underscore, and hyphen. Do not use short PINs.
HOST_INVITE_CODE=replace-with-a-random-host-code
GUEST_INVITE_CODE=replace-with-a-different-random-guest-code
# A fixed room in lsl-UUID format. Keep this value across restarts and code changes.
CALL_ROOM_NAME=replace-with-lsl-uuid
# Optional signed invitation links.
# Use a separate cryptographically random secret with at least 32 bytes.
INVITATION_SIGNING_SECRET=replace-with-a-random-server-only-secret
# Must exactly match the invitation's origin. No trailing slash.
APP_ORIGIN=http://localhost:3000
# Keep admission disabled until ready for controlled testing.
# Use a process override only for controlled local validation. Restart after changes.
ADMISSION_ENABLED=false
