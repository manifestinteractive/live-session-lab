# Copy to ignored .env.local. Enter real values locally, never in chat.
# Public demonstration pages work without credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-your-api-key
LIVEKIT_API_SECRET=replace-with-your-api-secret
# Use a separate cryptographically random secret with at least 32 bytes.
INVITATION_SIGNING_SECRET=replace-with-a-random-server-only-secret
# Must exactly match the invitation's origin. No trailing slash.
APP_ORIGIN=http://localhost:3000
# Keep external admission disabled until the documented capacity failure is resolved.
# Use a process override only for controlled local validation. Restart after changes.
ADMISSION_ENABLED=false
