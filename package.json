{
  "name": "live-session-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A browser video experiment with a disconnected Phase 1 interface.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ai:check": "node scripts/ai/check.mjs",
    "ai:verify": "node scripts/ai/verify.mjs",
    "ai:browser:install": "node scripts/ai/playwright.mjs install",
    "ai:mcp": "node scripts/ai/playwright.mjs",
    "ai:mcp:smoke": "node scripts/ai/mcp-smoke.mjs",
    "ai:docs:smoke": "node scripts/ai/mcp-smoke.mjs --docs",
    "ai:shadcn": "shadcn",
    "ai:shadcn:smoke": "node scripts/ai/shadcn-smoke.mjs",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:browser:install": "node scripts/test-browser-install.mjs",
    "build": "next build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "shadcn": "4.21.0",
    "smol-toml": "1.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0"
  }
}
