{
  "name": "live-session-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An invitation-only browser video experiment with LiveKit and WebRTC.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ai:check": "node scripts/ai/check.mjs",
    "ai:verify": "node scripts/ai/verify.mjs",
    "ai:browser:install": "node scripts/ai/playwright.mjs install",
    "ai:mcp": "node scripts/ai/playwright.mjs",
    "ai:mcp:smoke": "node scripts/ai/mcp-smoke.mjs",
    "ai:docs:smoke": "node scripts/ai/mcp-smoke.mjs --docs",
    "ai:shadcn": "shadcn",
    "ai:shadcn:smoke": "node scripts/ai/shadcn-smoke.mjs",
    "dev": "next dev",
    "lan:setup": "node scripts/local-network.mjs",
    "dev:lan": "node scripts/lan-run.mjs dev",
    "invite:lan": "node scripts/lan-run.mjs invite",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:browser:install": "node scripts/test-browser-install.mjs",
    "build": "next build",
    "invite": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/operator/invite.mjs",
    "test:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-live-call.mjs",
    "test:codes": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-code-call.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prepare": "node scripts/prepare.mjs",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.0",
    "smol-toml": "1.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@livekit/components-react": "2.9.24",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "jose": "6.2.12",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.0",
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0"
  }
}
